diff --git a/cmd/cmount/notify_windows.go b/cmd/cmount/notify_windows.go
new file mode 100644
index 0000000..6c6c3a2
--- /dev/null
+++ b/cmd/cmount/notify_windows.go
@@ -0,0 +1,169 @@
+//go:build cmount && windows
+
+package cmount
+
+import (
+	"errors"
+	"reflect"
+	"strings"
+	"sync"
+	"unsafe"
+
+	"github.com/rclone/rclone/vfs"
+	"github.com/winfsp/cgofuse/fuse"
+	"golang.org/x/sys/windows"
+)
+
+// WinFsp-FUSE uppercases the path in fuse_notify because it assumes the
+// file system doesn't report normalized names. cmount implements getpath,
+// so WinFsp registers directory watches under the real case of each name
+// and the uppercased notifications only ever match a watch on the root.
+// nativeNotify calls FspFileSystemNotify directly with the real case.
+
+var (
+	nativeMu         sync.Mutex
+	nativeMountpoint string
+	nativeVFS        *vfs.VFS
+	nativeFileSystem uintptr // FSP_FILE_SYSTEM *, found lazily
+
+	winfsp           = windows.NewLazyDLL("winfsp-x64.dll")
+	procNotifyBegin  = winfsp.NewProc("FspFileSystemNotifyBegin")
+	procNotify       = winfsp.NewProc("FspFileSystemNotify")
+	procNotifyEnd    = winfsp.NewProc("FspFileSystemNotifyEnd")
+	errNoFileSystem  = errors.New("winfsp file system not found")
+	errNotifyFailed  = errors.New("FspFileSystemNotify failed")
+)
+
+const (
+	fileNotifyChangeAttributes = 0x00000004
+	fileNotifyChangeSize       = 0x00000008
+	fileNotifyChangeLastWrite  = 0x00000010
+	fileActionModified         = 0x00000003
+)
+
+// setNotifyMount remembers the mount point and VFS for nativeNotify
+func setNotifyMount(mountpoint string, VFS *vfs.VFS) {
+	nativeMu.Lock()
+	defer nativeMu.Unlock()
+	nativeMountpoint = mountpoint
+	nativeVFS = VFS
+	nativeFileSystem = 0
+}
+
+// readMem reads n bytes at addr, failing instead of faulting on a bad address
+func readMem(addr uintptr, n int) ([]byte, bool) {
+	if addr == 0 || n <= 0 {
+		return nil, false
+	}
+	buf := make([]byte, n)
+	var done uintptr
+	err := windows.ReadProcessMemory(windows.CurrentProcess(), addr, &buf[0], uintptr(n), &done)
+	return buf, err == nil && int(done) == n
+}
+
+func readPtr(addr uintptr) (uintptr, bool) {
+	b, ok := readMem(addr, int(unsafe.Sizeof(uintptr(0))))
+	if !ok {
+		return 0, false
+	}
+	return *(*uintptr)(unsafe.Pointer(&b[0])), true
+}
+
+// readWide reads a NUL terminated UTF-16 string of at most max characters
+func readWide(addr uintptr, max int) (string, bool) {
+	b, ok := readMem(addr, max*2)
+	if !ok {
+		return "", false
+	}
+	u := unsafe.Slice((*uint16)(unsafe.Pointer(&b[0])), max)
+	for i, c := range u {
+		if c == 0 {
+			return windows.UTF16ToString(u[:i]), true
+		}
+	}
+	return "", false
+}
+
+// findFileSystem locates struct fuse::FileSystem: it follows MountPoint (PWSTR)
+// and LoopEvent (HANDLE), and is validated by the volume name it points to.
+func findFileSystem(host *fuse.FileSystemHost, mountpoint string) uintptr {
+	field := reflect.ValueOf(host).Elem().FieldByName("fuse")
+	if !field.IsValid() {
+		return 0
+	}
+	f := *(*uintptr)(unsafe.Pointer(field.UnsafeAddr()))
+	if f == 0 {
+		return 0
+	}
+	want := strings.TrimSuffix(strings.ToUpper(mountpoint), "\\")
+	for off := uintptr(0); off < 4096; off += 8 {
+		p, ok := readPtr(f + off)
+		if !ok || p < 0x10000 {
+			continue
+		}
+		s, ok := readWide(p, len(want)+1)
+		if !ok || strings.ToUpper(s) != want {
+			continue
+		}
+		fsp, ok := readPtr(f + off + 16) // MountPoint, LoopEvent, FileSystem
+		if !ok || fsp < 0x10000 {
+			continue
+		}
+		// FSP_FILE_SYSTEM: UINT16 Version; PVOID UserContext; WCHAR VolumeName[...]
+		name, ok := readWide(fsp+16, 256)
+		if ok && strings.HasPrefix(name, `\Device\`) {
+			return fsp
+		}
+	}
+	return 0
+}
+
+// nativeNotify reports a "modified" change (attributes, size, last write) for
+// each path, using the real case of the name as the directory watches do.
+func nativeNotify(host *fuse.FileSystemHost, paths []string) (int, error) {
+	if err := procNotify.Find(); err != nil {
+		return 0, err
+	}
+	nativeMu.Lock()
+	if nativeFileSystem == 0 {
+		nativeFileSystem = findFileSystem(host, nativeMountpoint)
+	}
+	fsp, VFS := nativeFileSystem, nativeVFS
+	nativeMu.Unlock()
+	if fsp == 0 {
+		return 0, errNoFileSystem
+	}
+	// FspFileSystemNotifyBegin returns STATUS_CANT_WAIT while a rename is in progress
+	for i := 0; ; i++ {
+		r, _, _ := procNotifyBegin.Call(fsp, 1000)
+		if r == 0 {
+			break
+		}
+		if i == 2 {
+			return 0, errNotifyFailed
+		}
+	}
+	defer func() { _, _, _ = procNotifyEnd.Call(fsp) }()
+	sent := 0
+	for _, p := range paths {
+		if VFS != nil {
+			if node, err := VFS.Stat(p); err == nil {
+				p = node.Path() // real case from the remote listing
+			}
+		}
+		name := windows.StringToUTF16(`\` + strings.ReplaceAll(p, "/", `\`))
+		name = name[:len(name)-1] // drop the NUL
+		// FSP_FSCTL_NOTIFY_INFO: UINT16 Size; UINT32 Filter; UINT32 Action; WCHAR FileNameBuf[]
+		size := 12 + 2*len(name)
+		buf := make([]byte, (size+7)&^7)
+		*(*uint16)(unsafe.Pointer(&buf[0])) = uint16(size)
+		*(*uint32)(unsafe.Pointer(&buf[4])) = fileNotifyChangeAttributes | fileNotifyChangeSize | fileNotifyChangeLastWrite
+		*(*uint32)(unsafe.Pointer(&buf[8])) = fileActionModified
+		copy(unsafe.Slice((*uint16)(unsafe.Pointer(&buf[12])), len(name)), name)
+		r, _, _ := procNotify.Call(fsp, uintptr(unsafe.Pointer(&buf[0])), uintptr(size))
+		if r == 0 {
+			sent++
+		}
+	}
+	return sent, nil
+}
diff --git a/cmd/cmount/winflags.go b/cmd/cmount/winflags.go
new file mode 100644
index 0000000..4ac5c8b
--- /dev/null
+++ b/cmd/cmount/winflags.go
@@ -0,0 +1,174 @@
+//go:build cmount && ((linux && cgo) || (darwin && cgo) || (freebsd && cgo) || (openbsd && cgo) || windows)
+
+package cmount
+
+import (
+	"context"
+	"errors"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/rclone/rclone/fs/rc"
+	"github.com/rclone/rclone/vfs"
+	"github.com/winfsp/cgofuse/fuse"
+)
+
+func init() {
+	rc.Add(rc.Call{
+		Path:  "mount/icondirs",
+		Fn:    rcIconDirs,
+		Title: "Set the folders that get the read-only attribute.",
+		Help: `
+Replaces the RCLONE_CMOUNT_ICON_DIRS list immediately, e.g.
+
+    rclone rc mount/icondirs dirs="Docs|Shared/*"
+`,
+	})
+}
+
+var (
+	notifyMu   sync.Mutex
+	notifyHost *fuse.FileSystemHost
+)
+
+// setNotifyHost remembers the mounted host so rc can send change notifications
+func setNotifyHost(host *fuse.FileSystemHost) {
+	notifyMu.Lock()
+	defer notifyMu.Unlock()
+	notifyHost = host
+}
+
+func init() {
+	rc.Add(rc.Call{
+		Path:  "mount/notify",
+		Fn:    rcNotify,
+		Title: "Send file system change notifications for paths.",
+		Help: `
+Tells the operating system that the given paths changed, as a local file
+system would. Explorer uses these to drop cached folder customizations
+(desktop.ini) and icons. Paths are separated by "|".
+
+    rclone rc mount/notify paths="Docs|Docs/desktop.ini"
+`,
+	})
+}
+
+// rcNotify sends a "modified" notification (attributes, times, size) for each path
+func rcNotify(ctx context.Context, in rc.Params) (rc.Params, error) {
+	list, err := in.GetString("paths")
+	if err != nil {
+		return nil, err
+	}
+	notifyMu.Lock()
+	host := notifyHost
+	notifyMu.Unlock()
+	if host == nil {
+		return nil, errors.New("not mounted")
+	}
+	var paths []string
+	for _, p := range strings.Split(list, "|") {
+		p = strings.Trim(strings.ReplaceAll(strings.TrimSpace(p), "\\", "/"), "/")
+		if p != "" {
+			paths = append(paths, p)
+		}
+	}
+	if sent, err := nativeNotify(host, paths); err == nil {
+		return rc.Params{"sent": sent, "native": true}, nil
+	}
+	sent := 0
+	for _, p := range paths {
+		if host.Notify("/"+p, fuse.NOTIFY_CHMOD|fuse.NOTIFY_CHFLAGS|fuse.NOTIFY_UTIME|fuse.NOTIFY_TRUNCATE) {
+			sent++
+		}
+	}
+	return rc.Params{"sent": sent, "native": false}, nil
+}
+
+// rcIconDirs replaces the folder list with the "dirs" parameter
+func rcIconDirs(ctx context.Context, in rc.Params) (rc.Params, error) {
+	list, err := in.GetString("dirs")
+	if err != nil {
+		return nil, err
+	}
+	iconMu.Lock()
+	defer iconMu.Unlock()
+	iconDirs, iconParents = parseIconDirs(list)
+	return rc.Params{}, nil
+}
+
+// Windows only shows a folder's desktop.ini icon when the folder has the
+// read-only (or system) attribute and desktop.ini is hidden+system.
+//
+// RCLONE_CMOUNT_ICON_DIRS lists the folders that get the read-only flag,
+// separated by "|". A trailing "/*" means "every direct child of".
+// Only these folders are flagged so Explorer doesn't probe desktop.ini
+// (and list the remote) in every folder of the mount.
+//
+// RCLONE_CMOUNT_ICON_DIRS_FILE, when set, names a file with the same list.
+// It is re-read (at most once a second) when it changes, so folders can be
+// added or removed without remounting.
+var (
+	iconMu                sync.Mutex
+	iconDirs, iconParents = parseIconDirs(os.Getenv("RCLONE_CMOUNT_ICON_DIRS"))
+	iconFile              = os.Getenv("RCLONE_CMOUNT_ICON_DIRS_FILE")
+	iconMod, iconChecked  time.Time
+)
+
+func parseIconDirs(list string) (dirs, parents map[string]bool) {
+	dirs, parents = map[string]bool{}, map[string]bool{}
+	for _, p := range strings.Split(list, "|") {
+		p = strings.ToLower(strings.Trim(strings.ReplaceAll(strings.TrimSpace(p), "\\", "/"), "/"))
+		if p == "" {
+			continue
+		}
+		if parent, ok := strings.CutSuffix(p, "/*"); ok {
+			parents[parent] = true
+		} else {
+			dirs[p] = true
+		}
+	}
+	return dirs, parents
+}
+
+// currentIconDirs returns the folder list, reloading the file if it changed
+func currentIconDirs() (dirs, parents map[string]bool) {
+	iconMu.Lock()
+	defer iconMu.Unlock()
+	if iconFile != "" && time.Since(iconChecked) > time.Second {
+		iconChecked = time.Now()
+		if st, err := os.Stat(iconFile); err == nil && !st.ModTime().Equal(iconMod) {
+			if b, err := os.ReadFile(iconFile); err == nil {
+				iconDirs, iconParents = parseIconDirs(string(b))
+				iconMod = st.ModTime()
+			}
+		}
+	}
+	return iconDirs, iconParents
+}
+
+// isIconDir reports whether dir gets the read-only flag for desktop.ini
+func isIconDir(node vfs.Node) bool {
+	dirs, parents := currentIconDirs()
+	p := strings.ToLower(strings.Trim(node.Path(), "/"))
+	parent := ""
+	if i := strings.LastIndex(p, "/"); i >= 0 {
+		parent = p[:i]
+	}
+	return dirs[p] || (p != "" && parents[parent])
+}
+
+// winFlags returns the BSD (Windows attribute) flags for node
+func winFlags(node vfs.Node) uint32 {
+	if node.IsDir() {
+		if isIconDir(node) {
+			return fuse.UF_READONLY
+		}
+		return 0
+	}
+	if strings.EqualFold(node.Name(), "desktop.ini") {
+		return fuse.UF_HIDDEN | fuse.UF_SYSTEM
+	}
+	return 0
+}
