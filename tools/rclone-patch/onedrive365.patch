+const goneParent = ":gone"
+
+// changeNotifyParentPath devolve o caminho de uma pasta pelo ID ("" = raiz do drive); ok=false se ela não existe mais
+func (f *Fs) changeNotifyParentPath(ctx context.Context, id string, cache map[string]string) (string, bool) {
+	if p, ok := cache[id]; ok {
+		return p, p != goneParent
+	}
+	var info api.Item
+	opts := f.newOptsCall(id, "GET", "")
+	opts.Parameters = url.Values{"$select": {"id,name,parentReference"}}
+	err := f.pacer.Call(func() (bool, error) {
+		resp, err := f.srv.CallJSON(ctx, &opts, nil, &info)
+		return shouldRetry(ctx, resp, err)
+	})
+	if err != nil {
+		fs.Debugf(f, "ChangeNotify: pasta %s não encontrada: %v", id, err)
+		cache[id] = goneParent
+		return "", false
+	}
+	p := ""
+	if info.GetParentReference().ID != "" {
+		if p, err = getItemFullPath(&info); err != nil {
+			cache[id] = goneParent
+			return "", false
+		}
+	}
+	cache[id] = p
+	return p, true
+}
