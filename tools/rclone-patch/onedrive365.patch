@@ -0,0 +1,163 @@
+//go:build cmount && ((linux && cgo) || (darwin && cgo) || (freebsd && cgo) || (openbsd && cgo) || windows)
+
+package cmount
+
+import (
+	"context"
+	"errors"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/rclone/rclone/fs/rc"
+	"github.com/rclone/rclone/vfs"
+	"github.com/winfsp/cgofuse/fuse"
+)
+
+func init() {
+	rc.Add(rc.Call{
+		Path:  "mount/icondirs",
+		Fn:    rcIconDirs,
+		Title: "Set the folders that get the read-only attribute.",
+		Help: `
+Replaces the RCLONE_CMOUNT_ICON_DIRS list immediately, e.g.
+
+    rclone rc mount/icondirs dirs="Docs|Shared/*"
+`,
+	})
+}
+
+var (
+	notifyMu   sync.Mutex
+	notifyHost *fuse.FileSystemHost
+)
+
+// setNotifyHost remembers the mounted host so rc can send change notifications
+func setNotifyHost(host *fuse.FileSystemHost) {
+	notifyMu.Lock()
+	defer notifyMu.Unlock()
+	notifyHost = host
+}
+
+func init() {
+	rc.Add(rc.Call{
+		Path:  "mount/notify",
+		Fn:    rcNotify,
+		Title: "Send file system change notifications for paths.",
+		Help: `
+Tells the operating system that the given paths changed, as a local file
+system would. Explorer uses these to drop cached folder customizations
+(desktop.ini) and icons. Paths are separated by "|".
+
+    rclone rc mount/notify paths="Docs|Docs/desktop.ini"
+`,
+	})
+}
+
+// rcNotify sends a "modified" notification (attributes, times, size) for each path
+func rcNotify(ctx context.Context, in rc.Params) (rc.Params, error) {
+	list, err := in.GetString("paths")
+	if err != nil {
+		return nil, err
+	}
+	notifyMu.Lock()
+	host := notifyHost
+	notifyMu.Unlock()
+	if host == nil {
+		return nil, errors.New("not mounted")
+	}
+	sent := 0
+	for _, p := range strings.Split(list, "|") {
+		p = strings.Trim(strings.ReplaceAll(strings.TrimSpace(p), "\\", "/"), "/")
+		if p == "" {
+			continue
+		}
+		if host.Notify("/"+p, fuse.NOTIFY_CHMOD|fuse.NOTIFY_CHFLAGS|fuse.NOTIFY_UTIME|fuse.NOTIFY_TRUNCATE) {
+			sent++
+		}
+	}
+	return rc.Params{"sent": sent}, nil
+}
+
+// rcIconDirs replaces the folder list with the "dirs" parameter
+func rcIconDirs(ctx context.Context, in rc.Params) (rc.Params, error) {
+	list, err := in.GetString("dirs")
+	if err != nil {
+		return nil, err
+	}
+	iconMu.Lock()
+	defer iconMu.Unlock()
+	iconDirs, iconParents = parseIconDirs(list)
+	return rc.Params{}, nil
+}
+
+// Windows only shows a folder's desktop.ini icon when the folder has the
+// read-only (or system) attribute and desktop.ini is hidden+system.
+//
+// RCLONE_CMOUNT_ICON_DIRS lists the folders that get the read-only flag,
+// separated by "|". A trailing "/*" means "every direct child of".
+// Only these folders are flagged so Explorer doesn't probe desktop.ini
+// (and list the remote) in every folder of the mount.
+//
+// RCLONE_CMOUNT_ICON_DIRS_FILE, when set, names a file with the same list.
+// It is re-read (at most once a second) when it changes, so folders can be
+// added or removed without remounting.
+var (
+	iconMu                sync.Mutex
+	iconDirs, iconParents = parseIconDirs(os.Getenv("RCLONE_CMOUNT_ICON_DIRS"))
+	iconFile              = os.Getenv("RCLONE_CMOUNT_ICON_DIRS_FILE")
+	iconMod, iconChecked  time.Time
+)
+
+func parseIconDirs(list string) (dirs, parents map[string]bool) {
+	dirs, parents = map[string]bool{}, map[string]bool{}
+	for _, p := range strings.Split(list, "|") {
+		p = strings.ToLower(strings.Trim(strings.ReplaceAll(strings.TrimSpace(p), "\\", "/"), "/"))
+		if p == "" {
+			continue
+		}
+		if parent, ok := strings.CutSuffix(p, "/*"); ok {
+			parents[parent] = true
+		} else {
+			dirs[p] = true
+		}
+	}
+	return dirs, parents
+}
+
+// currentIconDirs returns the folder list, reloading the file if it changed
+func currentIconDirs() (dirs, parents map[string]bool) {
+	iconMu.Lock()
+	defer iconMu.Unlock()
+	if iconFile != "" && time.Since(iconChecked) > time.Second {
+		iconChecked = time.Now()
+		if st, err := os.Stat(iconFile); err == nil && !st.ModTime().Equal(iconMod) {
+			if b, err := os.ReadFile(iconFile); err == nil {
+				iconDirs, iconParents = parseIconDirs(string(b))
+				iconMod = st.ModTime()
+			}
+		}
+	}
+	return iconDirs, iconParents
+}
+
+// winFlags returns the BSD (Windows attribute) flags for node
+func winFlags(node vfs.Node) uint32 {
+	if node.IsDir() {
+		dirs, parents := currentIconDirs()
+		p := strings.ToLower(strings.Trim(node.Path(), "/"))
+		parent := ""
+		if i := strings.LastIndex(p, "/"); i >= 0 {
+			parent = p[:i]
+		}
+		if dirs[p] || (p != "" && parents[parent]) {
+			return fuse.UF_READONLY
+		}
+		return 0
+	}
+	if strings.EqualFold(node.Name(), "desktop.ini") {
+		return fuse.UF_HIDDEN | fuse.UF_SYSTEM
+	}
+	return 0
+}
